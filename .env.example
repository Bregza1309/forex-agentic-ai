# =============================================================================
# Forex Agentic AI — Environment Variables
# =============================================================================
# Copy to .env and fill in your values: cp .env.example .env

# -----------------------------------------------------------------------------
# Supabase (local dev, run by `supabase start`)
# -----------------------------------------------------------------------------
# Auth keys are NOT committed here: newer Supabase CLIs generate per-instance
# signing keys, so the anon/service_role values differ on every machine.
# `make up` reads the live keys from `supabase start` and injects them
# automatically (see scripts/supabase-env.sh) -- you do NOT need to fill these in.
# They only matter if you bypass make and run `docker compose up` directly, in
# which case run `make supabase-status` and paste the real values here.
#
# Two URLs intentionally differ by run context:
#   SUPABASE_URL       -> used by the Temporal worker, which runs INSIDE Docker and
#                         reaches the host-bound Supabase via host.docker.internal.
#   VITE_SUPABASE_URL  -> used by the frontend, which runs in the browser on the HOST.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=injected-by-make-up
SUPABASE_SERVICE_ROLE_KEY=injected-by-make-up

# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=forex-main

# -----------------------------------------------------------------------------
# Frontend (browser on the host -> localhost)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=injected-by-make-up
VITE_API_URL=http://localhost:54321/functions/v1

# -----------------------------------------------------------------------------
# AWS Bedrock (Claude AI)
# Required: Claude models must be enabled in the specified region.
# For SSO/assumed-role workflows, set AWS_SESSION_TOKEN as well.
# -----------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=              # Only needed for temporary credentials / SSO

# -----------------------------------------------------------------------------
# Free API Keys (register for free at each provider)
# -----------------------------------------------------------------------------
# Alpha Vantage — forex intraday/daily (25 req/day free)
# Register: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED — US economic indicators (120 req/min free)
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# News API — financial headlines (100 req/day free developer tier)
# Register: https://newsapi.org/register
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# Optional — additional data sources
# -----------------------------------------------------------------------------
# OANDA practice account — streaming forex prices
# Register: https://www.oanda.com/apply/demo
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=

# Reddit API — sentiment from r/forex, r/trading
# Register: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=forex-agentic-ai/1.0

# Open Exchange Rates — 170+ currencies (1,000 req/month free)
# Register: https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=
